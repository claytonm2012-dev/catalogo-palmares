<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; background: #f8f6f2; color: #333; }
      .shell { display: flex; min-height: 100vh; }
      .sidebar { width: 260px; background: #1f2937; color: white; padding: 24px; }
      .content { flex: 1; padding: 24px; }
      form { background: white; padding: 20px; border-radius: 12px; }
      input, textarea, select { width: 100%; padding: 10px; margin-bottom: 10px; border-radius: 8px; border: 1px solid #ddd; }
      .btn { display: inline-block; padding: 10px 14px; border-radius: 8px; background: #8b5e34; color: white; border: none; cursor: pointer; }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <h2>Grupo Palmares</h2>
        <p>Admin</p>
        <ul>
          <li><a href="/" style="color:white">&larr; Voltar ao catálogo</a></li>
          <li><a href="/admin/dashboard" style="color:white">Dashboard</a></li>
          <li><a href="/admin/products" style="color:white">Produtos</a></li>
          <li><a href="/admin/categories" style="color:white">Categorias</a></li>
          <li><a href="/admin/brands" style="color:white">Marcas</a></li>
          <li><a href="/admin/qr-codes" style="color:white">QR Codes</a></li>
          <li><a href="/admin/logout" style="color:white">Sair</a></li>
        </ul>
      </aside>
      <main class="content">
        <h1><%= title %></h1>
        <% if (typeof error !== 'undefined' && error) { %>
          <div style="background:#fdecea;color:#b23b3b;border:1px solid #f3c2bd;padding:12px 16px;border-radius:8px;margin-bottom:16px"><%= error %></div>
        <% } %>
        <form method="post" action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>" enctype="multipart/form-data">
          <label style="display:block;font-size:13px;font-weight:bold;margin-bottom:6px">Imagem principal</label>
          <% if (product && product.main_image) { %>
            <img src="<%= product.main_image %>" alt="Imagem atual" style="max-width:160px;border-radius:8px;margin-bottom:8px;display:block" />
          <% } %>
          <input type="file" name="main_image_file" accept="image/*" />
          <p style="margin:-4px 0 12px;font-size:12px;color:#777">Envie uma imagem para <%= product && product.main_image ? 'substituir a atual' : 'definir a foto do produto' %> (PNG, JPG ou WEBP).</p>

          <input name="name" placeholder="Nome" value="<%= product ? product.name : '' %>" required />
          <input name="sku" placeholder="SKU" value="<%= product ? product.sku : '' %>" required />
          <input name="slug" placeholder="Slug" value="<%= product ? product.slug : '' %>" />
          <textarea name="description_short" placeholder="Descrição curta"><%= product ? product.description_short : '' %></textarea>
          <textarea name="description" placeholder="Descrição completa"><%= product ? product.description : '' %></textarea>
          <select name="category_id">
            <option value="">Categoria</option>
            <% categories.forEach(function(category){ %>
              <option value="<%= category.id %>" <%= product && product.category_id == category.id ? 'selected' : '' %>><%= category.name %></option>
            <% }) %>
          </select>
          <select name="brand_id">
            <option value="">Marca</option>
            <% brands.forEach(function(brand){ %>
              <option value="<%= brand.id %>" <%= product && product.brand_id == brand.id ? 'selected' : '' %>><%= brand.name %></option>
            <% }) %>
          </select>
          <select name="collection_id">
            <option value="">Coleção</option>
            <% collections.forEach(function(collection){ %>
              <option value="<%= collection.id %>" <%= product && product.collection_id == collection.id ? 'selected' : '' %>><%= collection.name %></option>
            <% }) %>
          </select>
          <input name="material" placeholder="Material" value="<%= product ? product.material : '' %>" />
          <input name="color" placeholder="Cor" value="<%= product ? product.color : '' %>" />
          <input name="capacity" placeholder="Capacidade" value="<%= product ? product.capacity : '' %>" />
          <input name="measures" placeholder="Medidas" value="<%= product ? product.measures : '' %>" />
          <input name="weight" placeholder="Peso" value="<%= product ? product.weight : '' %>" />
          <input name="pieces_quantity" placeholder="Quantidade de peças" value="<%= product ? product.pieces_quantity : '' %>" />
          <input name="box_quantity" placeholder="Quantidade por caixa" value="<%= product ? product.box_quantity : '' %>" />
          <input name="origin" placeholder="Origem" value="<%= product ? product.origin : '' %>" />
          <select name="status">
            <option value="active" <%= product && product.status === 'active' ? 'selected' : '' %>>Ativo</option>
            <option value="inactive" <%= product && product.status === 'inactive' ? 'selected' : '' %>>Inativo</option>
          </select>
          <select name="is_launch">
            <option value="no" <%= product && product.is_launch === 'no' ? 'selected' : '' %>>Não é lançamento</option>
            <option value="yes" <%= product && product.is_launch === 'yes' ? 'selected' : '' %>>Lançamento</option>
          </select>
          <select name="is_featured">
            <option value="no" <%= product && product.is_featured === 'no' ? 'selected' : '' %>>Não destaque</option>
            <option value="yes" <%= product && product.is_featured === 'yes' ? 'selected' : '' %>>Destaque</option>
          </select>
          <% if (product) { %>
            <label style="display:block;font-size:13px;font-weight:bold;margin-bottom:6px">Galeria (imagens adicionais)</label>
            <input type="file" name="gallery_files" accept="image/*" multiple />
            <p style="margin:-4px 0 12px;font-size:12px;color:#777">Você pode selecionar várias imagens de uma vez. Elas serão adicionadas à galeria ao salvar.</p>
          <% } %>

          <button class="btn" type="submit">Salvar</button>
        </form>

        <% if (product && images && images.length) { %>
          <div style="margin-top:20px;background:white;padding:20px;border-radius:12px">
            <h3 style="margin-top:0">Imagens da galeria</h3>
            <div style="display:flex;flex-wrap:wrap;gap:12px">
              <% images.forEach(function(img){ %>
                <div style="text-align:center">
                  <img src="<%= img.url %>" alt="Imagem da galeria" style="width:110px;height:110px;object-fit:cover;border-radius:8px;display:block;margin-bottom:6px" />
                  <form method="post" action="/admin/products/<%= product.id %>/images/<%= img.id %>/delete" onsubmit="return confirm('Remover esta imagem?')">
                    <button class="btn" type="submit" style="background:#b23b3b;padding:6px 10px;font-size:12px">Remover</button>
                  </form>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </main>
    </div>
  </body>
</html>
