<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/premium.css?v=4.3">
    <link rel="stylesheet" href="/css/admin-premium.css?v=1.0">
    <style>
      .dash-grid{display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-top:24px}
      @media (max-width:1000px){ .dash-grid{grid-template-columns:1fr} }
      .dash-list{display:flex;flex-direction:column;gap:2px}
      .dash-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(6,32,59,0.06);font-size:13.5px}
      .dash-row:last-child{border-bottom:none}
      .dash-row .name{color:var(--navy-900);font-weight:600}
      .dash-row .meta{color:var(--muted);font-size:12px}
      .quick-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px}
    </style>
  </head>
  <body>
    <div class="admin-shell">
      <%- include('partials/sidebar', { active: active, user: user }) %>
      <main class="admin-content">
        <div class="admin-page-head">
          <div>
            <span class="admin-kicker">Painel administrativo</span>
            <h1>Dashboard</h1>
            <p>Bem-vindo, <%= user.name %>.</p>
          </div>
        </div>

        <div class="quick-actions">
          <a class="btn-sm" href="/admin/products/new">+ Produto</a>
          <a class="btn-sm" href="/admin/categories">+ Categoria</a>
          <a class="btn-sm" href="/admin/brands">+ Marca</a>
        </div>

        <div class="stat-grid" style="margin-top:20px">
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/></svg></div>
            <div class="stat-value"><%= stats.products %></div>
            <div class="stat-label">Produtos</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div class="stat-value"><%= stats.activeProducts %></div>
            <div class="stat-label">Ativos</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.9" y1="4.9" x2="19.1" y2="19.1"/></svg></div>
            <div class="stat-value"><%= stats.inactiveProducts %></div>
            <div class="stat-label">Inativos</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></div>
            <div class="stat-value"><%= stats.categories %></div>
            <div class="stat-label">Categorias</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.6 6.2L21 9l-5 4.6L17.4 21 12 17.3 6.6 21 8 13.6 3 9l6.4-.8z"/></svg></div>
            <div class="stat-value"><%= stats.brands %></div>
            <div class="stat-label">Marcas</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z"/></svg></div>
            <div class="stat-value"><%= stats.launches %></div>
            <div class="stat-label">Lançamentos</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9"/></svg></div>
            <div class="stat-value"><%= stats.featured %></div>
            <div class="stat-label">Destaques</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></div>
            <div class="stat-value"><%= stats.views %></div>
            <div class="stat-label">Visualizações</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><line x1="14" y1="14" x2="14" y2="21"/><line x1="21" y1="14" x2="21" y2="21"/><line x1="14" y1="17.5" x2="21" y2="17.5"/></svg></div>
            <div class="stat-value"><%= stats.qrScans %></div>
            <div class="stat-label">QRs lidos</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
            <div class="stat-value"><%= stats.qrTested %></div>
            <div class="stat-label">QRs testados</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
            <div class="stat-value"><%= stats.qrErrors %></div>
            <div class="stat-label">QRs com erro</div>
          </div>
        </div>

        <div class="dash-grid">
          <div class="admin-card">
            <label class="field-label">Últimos produtos cadastrados</label>
            <div class="dash-list">
              <% recentProducts.forEach(function(p){ %>
                <div class="dash-row">
                  <span class="name"><%= p.name %></span>
                  <span class="meta"><%= p.sku %> · <%= new Date(p.created_at).toLocaleDateString('pt-BR') %></span>
                </div>
              <% }) %>
              <% if (!recentProducts.length) { %><p class="admin-hint">Nenhum produto cadastrado ainda.</p><% } %>
            </div>
          </div>

          <div class="admin-card">
            <label class="field-label">Alertas</label>
            <div class="dash-list">
              <% if (stats.qrErrors > 0) { %>
                <div class="dash-row"><span class="name" style="color:#b23b3b">QR Codes com problema</span><span class="meta"><a href="/admin/qr-codes"><%= stats.qrErrors %> produto(s)</a></span></div>
              <% } %>
              <% if (brokenImages.length > 0) { %>
                <div class="dash-row"><span class="name" style="color:#b23b3b">Produtos sem imagem principal</span><span class="meta"><%= brokenImages.length %></span></div>
              <% } %>
              <% if (stats.qrErrors === 0 && brokenImages.length === 0) { %>
                <p class="admin-hint">Nenhum alerta no momento.</p>
              <% } %>
            </div>
          </div>

          <div class="admin-card">
            <label class="field-label">Produtos mais visualizados</label>
            <div class="dash-list">
              <% mostViewed.forEach(function(p){ %>
                <div class="dash-row">
                  <span class="name"><%= p.name %></span>
                  <span class="meta"><%= p.view_count || 0 %> views</span>
                </div>
              <% }) %>
              <% if (!mostViewed.length) { %><p class="admin-hint">Sem dados de visualização ainda.</p><% } %>
            </div>
          </div>

          <div class="admin-card">
            <label class="field-label">Últimas alterações</label>
            <div class="dash-list">
              <% recentLogs.forEach(function(log){ %>
                <div class="dash-row">
                  <span class="name"><%= log.action %> · <%= log.entity %></span>
                  <span class="meta"><%= new Date(log.created_at).toLocaleString('pt-BR') %></span>
                </div>
              <% }) %>
              <% if (!recentLogs.length) { %><p class="admin-hint">Nenhuma ação registrada ainda.</p><% } %>
            </div>
            <a class="btn-sm" href="/admin/logs" style="margin-top:12px;display:inline-flex">Ver histórico completo</a>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
