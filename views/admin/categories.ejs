<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/premium.css?v=4.2">
    <link rel="stylesheet" href="/css/admin-premium.css?v=1.0">
  </head>
  <body>
    <div class="admin-shell">
      <%- include('partials/sidebar', { active: active, user: user }) %>
      <main class="admin-content">
        <div class="admin-page-head">
          <div>
            <span class="admin-kicker">Catálogo</span>
            <h1>Categorias</h1>
            <p><%= categories.length %> categoria<%= categories.length === 1 ? '' : 's' %></p>
          </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="admin-error-banner"><%= error %></div>
        <% } %>

        <div class="admin-card admin-form">
          <label class="field-label">Nova categoria</label>
          <form method="post" action="/admin/categories" enctype="multipart/form-data">
            <div class="admin-form-grid">
              <input name="name" placeholder="Nome" required />
              <input name="slug" placeholder="Slug (opcional)" />
            </div>
            <textarea name="description" placeholder="Descrição"></textarea>
            <label class="field-label">Imagem de capa</label>
            <input type="file" name="image" accept="image/*" />
            <div class="admin-form-grid" style="margin-top:10px">
              <select name="status"><option value="active">Ativa</option><option value="inactive">Inativa</option></select>
              <button class="btn" type="submit">Salvar</button>
            </div>
          </form>
        </div>

        <% categories.forEach(function(category){ %>
          <div class="admin-card admin-form" style="margin-top:16px">
            <div class="admin-actions" style="justify-content:space-between;margin-bottom:14px">
              <div style="display:flex;align-items:center;gap:12px">
                <% if (category.image) { %>
                  <img src="<%= category.image %>" alt="" style="width:44px;height:44px;object-fit:cover;border-radius:8px" />
                <% } %>
                <strong style="color:var(--navy-900)"><%= category.name %></strong>
                <span class="admin-hint" style="margin:0"><%= category.product_count %> produto<%= category.product_count === 1 ? '' : 's' %></span>
              </div>
              <span class="status-pill <%= category.status %>"><%= category.status === 'active' ? 'Ativa' : 'Inativa' %></span>
            </div>
            <form method="post" action="/admin/categories/<%= category.id %>" enctype="multipart/form-data">
              <div class="admin-form-grid">
                <input name="name" value="<%= category.name %>" placeholder="Nome" />
                <input name="slug" value="<%= category.slug %>" placeholder="Slug" />
              </div>
              <textarea name="description"><%= category.description %></textarea>
              <label class="field-label">Substituir imagem de capa</label>
              <input type="file" name="image" accept="image/*" />
              <div class="admin-form-grid" style="margin-top:10px">
                <select name="status"><option value="active" <%= category.status === 'active' ? 'selected' : '' %>>Ativa</option><option value="inactive" <%= category.status === 'inactive' ? 'selected' : '' %>>Inativa</option></select>
                <button class="btn-sm" type="submit">Atualizar</button>
              </div>
            </form>
            <form method="post" action="/admin/categories/<%= category.id %>/delete" class="delete-category-form" data-count="<%= category.product_count %>" style="margin-top:10px">
              <input type="hidden" name="confirmed" value="0" />
              <button type="submit" class="btn-sm danger">Excluir</button>
            </form>
          </div>
        <% }) %>
      </main>
    </div>
    <script>
      document.querySelectorAll('.delete-category-form').forEach(function(form){
        form.addEventListener('submit', function(e){
          var count = parseInt(form.getAttribute('data-count'), 10) || 0;
          if (count > 0) {
            var ok = confirm('Esta categoria tem ' + count + ' produto(s) vinculado(s). Eles ficarão sem categoria. Deseja excluir mesmo assim?');
            if (!ok) { e.preventDefault(); return; }
            form.querySelector('input[name="confirmed"]').value = '1';
          } else if (!confirm('Excluir esta categoria?')) {
            e.preventDefault();
          }
        });
      });
    </script>
  </body>
</html>
