<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/premium.css?v=4.2">
    <link rel="stylesheet" href="/css/admin-premium.css?v=1.0">
    <style>
      .url-cell { font-family: 'SFMono-Regular', Consolas, monospace; font-size: 12.5px; word-break: break-all; color: var(--muted); }
      .status-badge { display:inline-block; padding:4px 10px; border-radius:999px; font-size:11px; font-weight:700; }
      .status-ok { background:#e3f5e6; color:#1c7a34; }
      .status-fail { background:#fdecea; color:#b23b3b; }
      .status-pending { background:#f1f2f4; color:#6b7b8a; }
      .test-meta { display:block; font-size:10.5px; color:var(--muted); margin-top:3px; }
    </style>
  </head>
  <body>
    <div class="admin-shell">
      <%- include('partials/sidebar', { active: active, user: user }) %>
      <main class="admin-content">
        <div class="admin-page-head">
          <div>
            <span class="admin-kicker">Catálogo</span>
            <h1>QR Codes</h1>
            <p><%= products.length %> produto<%= products.length === 1 ? '' : 's' %> com QR Code gerado por SKU</p>
          </div>
          <div class="admin-actions">
            <label style="display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--muted);font-weight:600">
              <input type="checkbox" id="forceRetest" style="width:auto;margin:0" />
              Forçar reteste (ignorar testados recentemente)
            </label>
            <button type="button" class="btn-sm" id="testAllBtn">Testar todos</button>
            <a class="btn-sm" href="/admin/qr-codes/export.csv">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Baixar planilha CSV
            </a>
          </div>
        </div>

        <% if (usesLocalhost) { %>
          <div class="admin-error-banner">
            <strong>Atenção:</strong> a URL base configurada (<code><%= baseUrl %></code>) usa <code>localhost</code>. QR Codes gerados agora NÃO devem ser impressos — configure a variável de ambiente <code>PUBLIC_SITE_URL</code> com o domínio de produção antes da exportação final.
          </div>
        <% } %>
        <p class="admin-hint" style="margin-top:0">Domínio base atual: <code><%= baseUrl %></code></p>
        <div id="testAllProgressWrap" style="display:none;margin:0 0 14px">
          <div style="background:rgba(6,32,59,0.08);border-radius:999px;height:8px;overflow:hidden">
            <div id="testAllProgressBar" style="height:100%;width:0%;background:linear-gradient(90deg,var(--gold-light),var(--gold));transition:width .2s ease"></div>
          </div>
        </div>
        <p id="testAllSummary" class="admin-hint" style="margin-top:0"></p>

        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Produto</th><th>SKU</th><th>URL pública</th><th>Status</th><th>Ações</th></tr>
            </thead>
            <tbody>
              <% var statusLabels = {
                funcionando: ['status-ok', 'Funcionando'],
                produto_inativo: ['status-fail', 'Produto inativo'],
                pagina_inexistente: ['status-fail', 'Página inexistente'],
                produto_incorreto: ['status-fail', 'Abre produto errado'],
                erro_dominio: ['status-fail', 'Aponta para localhost']
              }; %>
              <% products.forEach(function(product){
                var known = product.last_qr_test_status && statusLabels[product.last_qr_test_status];
              %>
                <tr id="row-<%= product.sku %>">
                  <td><%= product.name %></td>
                  <td><%= product.sku %></td>
                  <td class="url-cell"><%= product.publicUrl %></td>
                  <td class="test-status" data-sku="<%= product.sku %>" data-tested-at="<%= product.last_qr_test_at || '' %>">
                    <% if (known) { %>
                      <span class="status-badge <%= known[0] %>"><%= known[1] %></span>
                      <span class="test-meta">testado em <%= new Date(product.last_qr_test_at).toLocaleString('pt-BR') %></span>
                    <% } else { %>
                      <span class="status-badge status-pending">não testado</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="admin-actions">
                      <a class="btn-sm" href="<%= product.publicUrl %>" target="_blank" rel="noopener">Abrir</a>
                      <button type="button" class="btn-sm" data-copy="<%= product.publicUrl %>">Copiar link</button>
                      <a class="btn-sm" href="/qr/<%= product.sku %>?download=1" target="_blank">PNG</a>
                      <a class="btn-sm" href="/qr/<%= product.sku %>.svg" target="_blank">SVG</a>
                      <a class="btn-sm" href="/admin/qr-codes/<%= product.sku %>/print" target="_blank">Imprimir</a>
                      <button type="button" class="btn-sm" data-test-sku="<%= product.sku %>">Testar</button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </main>
    </div>
    <script>
      var statusLabelMap = {
        funcionando: ['status-ok', 'Funcionando'],
        produto_inativo: ['status-fail', 'Produto inativo'],
        pagina_inexistente: ['status-fail', 'Página inexistente'],
        produto_incorreto: ['status-fail', 'Abre produto errado'],
        erro_dominio: ['status-fail', 'Aponta para localhost']
      };
      function renderStatusCell(cell, data) {
        var mapped = statusLabelMap[data.testStatus] || ['status-fail', 'Erro'];
        var when = data.testedAt ? new Date(data.testedAt).toLocaleString('pt-BR') : '';
        cell.innerHTML = '<span class="status-badge ' + mapped[0] + '">' + mapped[1] + '</span><span class="test-meta">testado em ' + when + '</span>';
      }
      document.querySelectorAll('[data-copy]').forEach(function(btn){
        btn.addEventListener('click', function(){
          navigator.clipboard.writeText(btn.getAttribute('data-copy')).then(function(){
            var original = btn.textContent; btn.textContent = 'Copiado!';
            setTimeout(function(){ btn.textContent = original; }, 1200);
          });
        });
      });
      document.querySelectorAll('[data-test-sku]').forEach(function(btn){
        btn.addEventListener('click', function(){
          var sku = btn.getAttribute('data-test-sku');
          var cell = document.querySelector('.test-status[data-sku="' + sku + '"]');
          cell.innerHTML = '<span class="status-badge status-pending">testando...</span>';
          fetch('/admin/qr-codes/' + encodeURIComponent(sku) + '/testar')
            .then(function(res){ return res.json(); })
            .then(function(data){ renderStatusCell(cell, data); })
            .catch(function(){ cell.innerHTML = '<span class="status-badge status-fail">Erro ao testar</span>'; });
        });
      });
      // Lote controlado: no maximo N testes simultaneos, nunca todos de uma vez.
      // Pula quem ja foi testado ha pouco tempo, a menos que "Forcar reteste" esteja marcado.
      var RECENT_TEST_MS = 10 * 60 * 1000; // 10 minutos
      var CONCURRENCY = 4;

      async function runWithConcurrency(items, limit, worker) {
        var index = 0;
        async function run() {
          while (index < items.length) {
            var current = index++;
            await worker(items[current], current);
          }
        }
        var runners = [];
        for (var i = 0; i < Math.min(limit, items.length); i++) runners.push(run());
        await Promise.all(runners);
      }

      document.getElementById('testAllBtn').addEventListener('click', async function(){
        var btn = this;
        var force = document.getElementById('forceRetest').checked;
        var allCells = Array.prototype.slice.call(document.querySelectorAll('.test-status[data-sku]'));
        var now = Date.now();
        var toTest = allCells.filter(function(cell){
          if (force) return true;
          var testedAt = cell.getAttribute('data-tested-at');
          if (!testedAt) return true;
          return (now - new Date(testedAt).getTime()) > RECENT_TEST_MS;
        });
        var skipped = allCells.length - toTest.length;

        if (!toTest.length) {
          document.getElementById('testAllSummary').textContent = 'Todos os ' + allCells.length + ' QR Codes ja foram testados recentemente. Marque "Forçar reteste" para testar de novo.';
          return;
        }

        btn.disabled = true; btn.textContent = 'Testando...';
        var progressWrap = document.getElementById('testAllProgressWrap');
        var progressBar = document.getElementById('testAllProgressBar');
        progressWrap.style.display = 'block';
        progressBar.style.width = '0%';

        var done = 0;
        var summary = {};
        await runWithConcurrency(toTest, CONCURRENCY, async function(cell){
          var sku = cell.getAttribute('data-sku');
          cell.innerHTML = '<span class="status-badge status-pending">testando...</span>';
          try {
            var res = await fetch('/admin/qr-codes/' + encodeURIComponent(sku) + '/testar');
            var data = await res.json();
            renderStatusCell(cell, data);
            cell.setAttribute('data-tested-at', data.testedAt || new Date().toISOString());
            summary[data.testStatus] = (summary[data.testStatus] || 0) + 1;
          } catch (e) {
            cell.innerHTML = '<span class="status-badge status-fail">Erro ao testar</span>';
            summary.erro_rede = (summary.erro_rede || 0) + 1;
          }
          done++;
          progressBar.style.width = Math.round((done / toTest.length) * 100) + '%';
        });

        var summaryParts = Object.keys(summary).map(function(key){ return (statusLabelMap[key] ? statusLabelMap[key][1] : key) + ': ' + summary[key]; });
        var skippedText = skipped ? (' (' + skipped + ' pulado(s) — testado(s) recentemente)') : '';
        document.getElementById('testAllSummary').textContent = toTest.length + ' QR Codes testados' + skippedText + ' — ' + summaryParts.join(', ');
        btn.disabled = false; btn.textContent = 'Testar todos';
      });
    </script>
  </body>
</html>
