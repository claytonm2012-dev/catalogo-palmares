<%
/* Simple geometric line-art icon per category slug, drawn only with
   circle/ellipse/rect/line so it always renders cleanly at any size. */
%>
<svg class="ph-icon" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<% if (icon === 'vidro') { %>
  <ellipse cx="60" cy="28" rx="26" ry="8"/>
  <path d="M34,28 L52,72 L68,72 L86,28"/>
  <line x1="60" y1="72" x2="60" y2="95"/>
  <line x1="40" y1="95" x2="80" y2="95"/>
<% } else if (icon === 'porcelanas') { %>
  <ellipse cx="60" cy="66" rx="40" ry="14"/>
  <ellipse cx="60" cy="66" rx="23" ry="7"/>
  <line x1="40" y1="34" x2="40" y2="46"/>
  <line x1="60" y1="28" x2="60" y2="44"/>
  <line x1="80" y1="34" x2="80" y2="46"/>
<% } else if (icon === 'termico') { %>
  <rect x="45" y="18" width="30" height="14" rx="4"/>
  <rect x="38" y="32" width="44" height="62" rx="12"/>
  <line x1="38" y1="54" x2="82" y2="54"/>
<% } else if (icon === 'metalurgico') { %>
  <circle cx="60" cy="60" r="22"/>
  <line x1="84" y1="60" x2="94" y2="60"/>
  <line x1="77" y1="77" x2="84" y2="84"/>
  <line x1="60" y1="84" x2="60" y2="94"/>
  <line x1="43" y1="77" x2="36" y2="84"/>
  <line x1="36" y1="60" x2="26" y2="60"/>
  <line x1="43" y1="43" x2="36" y2="36"/>
  <line x1="60" y1="36" x2="60" y2="26"/>
  <line x1="77" y1="43" x2="84" y2="36"/>
<% } else if (icon === 'inox') { %>
  <ellipse cx="60" cy="40" rx="30" ry="8"/>
  <rect x="30" y="40" width="60" height="42" rx="8"/>
  <line x1="18" y1="55" x2="30" y2="55"/>
  <line x1="90" y1="55" x2="102" y2="55"/>
<% } else if (icon === 'aluminio') { %>
  <circle cx="52" cy="62" r="26"/>
  <line x1="76" y1="60" x2="102" y2="44"/>
<% } else if (icon === 'plastico') { %>
  <rect x="34" y="56" width="52" height="32" rx="7"/>
  <rect x="42" y="40" width="36" height="18" rx="5"/>
<% } else if (icon === 'importados') { %>
  <circle cx="60" cy="60" r="32"/>
  <ellipse cx="60" cy="60" rx="32" ry="14"/>
  <line x1="60" y1="28" x2="60" y2="92"/>
<% } else { %>
  <rect x="32" y="45" width="56" height="42" rx="6"/>
  <line x1="60" y1="45" x2="60" y2="87"/>
  <line x1="32" y1="66" x2="88" y2="66"/>
<% } %>
</svg>
