<div class="qr-modal" id="qrModal" aria-hidden="true">
  <div class="qr-modal-backdrop" data-qr-close></div>
  <div class="qr-modal-panel">
    <button class="qr-modal-close" data-qr-close type="button" aria-label="Fechar">&times;</button>
    <div class="qr-frame">
      <div class="qr-scan-line"></div>
      <img class="qr-image" alt="QR Code do produto" />
    </div>
    <p class="muted">Aponte a câmera para acessar este produto</p>
  </div>
</div>
