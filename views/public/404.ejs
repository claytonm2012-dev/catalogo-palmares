<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Página não encontrada</title>
    <link rel="stylesheet" href="/css/premium.css?v=4.3">
    <style>
      body{display:grid;place-items:center;min-height:100vh}
      .nf-card{max-width:440px;width:100%;margin:0 20px;padding:44px 36px;background:var(--card);border-radius:var(--radius-card);box-shadow:var(--shadow-card-light);text-align:center;border:1px solid rgba(6,32,59,0.06)}
      .nf-code{font-size:13px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--gold);margin:0 0 10px}
      .nf-card h1{font-size:clamp(1.6rem, 1.2rem + 1.2vw, 2.1rem);margin:0 0 10px;color:var(--navy-900);letter-spacing:-.3px}
      .nf-card p{margin:0 0 26px;color:var(--muted);line-height:1.6}
    </style>
  </head>
  <body>
    <div class="nf-card">
      <p class="nf-code">Erro 404</p>
      <h1>Página não encontrada</h1>
      <p>O endereço acessado não existe ou foi movido.</p>
      <a class="btn" href="/">Voltar ao catálogo</a>
    </div>
  </body>
</html>
